{
  "swagger": "2.0",
  "info": {
    "title": "Training FHIR Patient API",
    "version": "1.0.0",
    "description": "REST facade over data.patient with R4 FHIR Patient representations."
  },
  "basePath": "/fhir",
  "schemes": ["http", "https"],
  "produces": ["application/json", "application/fhir+json"],
  "paths": {
    "/version": {
      "get": {
        "operationId": "GetVersion",
        "summary": "Get IRIS instance details",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Current IRIS instance details",
            "schema": { "$ref": "#/definitions/VersionDetails" }
          }
        }
      }
    },
    "/versionpy": {
      "get": {
        "operationId": "GetVersionPyResponse",
        "summary": "Get IRIS instance details from Embedded Python",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Current IRIS instance details including uptime",
            "schema": { "$ref": "#/definitions/VersionDetails" }
          }
        }
      }
    },
    "/Patient": {
      "post": {
        "operationId": "SyncPatient",
        "summary": "Synchronize a Patient with the FHIR repository",
        "description": "Creates or updates the target Patient from the supplied FHIR resource.",
        "consumes": ["application/fhir+json", "application/json"],
        "produces": ["application/fhir+json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "FHIR Patient to synchronize.",
            "schema": { "$ref": "#/definitions/Patient" }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing FHIR Patient updated",
            "headers": {
              "X-FHIR-HTTP-Method": { "type": "string", "enum": ["POST", "PUT"] },
              "Content-Location": { "type": "string" }
            },
            "schema": { "$ref": "#/definitions/Patient" }
          },
          "201": {
            "description": "FHIR Patient created",
            "headers": {
              "X-FHIR-HTTP-Method": { "type": "string", "enum": ["POST", "PUT"] },
              "Content-Location": { "type": "string" }
            },
            "schema": { "$ref": "#/definitions/Patient" }
          },
          "400": { "$ref": "#/responses/InvalidPatient" },
          "500": { "$ref": "#/responses/InternalError" },
          "502": { "$ref": "#/responses/FHIRGatewayError" }
        }
      }
    },
    "/Patient/{id}": {
      "get": {
        "operationId": "GetPatient",
        "summary": "Project a source patient as an R4 FHIR Patient",
        "description": "Returns the mapped Patient without persisting it to the FHIR repository.",
        "produces": ["application/fhir+json"],
        "parameters": [
          { "$ref": "#/parameters/PatientSourceId" }
        ],
        "responses": {
          "200": {
            "description": "Mapped FHIR Patient",
            "schema": { "$ref": "#/definitions/Patient" }
          },
          "404": { "$ref": "#/responses/NotFound" },
          "500": { "$ref": "#/responses/InternalError" }
        }
      },
      "put": {
        "operationId": "PutPatient",
        "summary": "Update the home address and upsert the Patient in FHIR",
        "description": "The source id and IPP identifier are immutable. The first home address is imported into data.patient before an idempotent FHIR PUT.",
        "consumes": ["application/fhir+json", "application/json"],
        "produces": ["application/fhir+json"],
        "parameters": [
          { "$ref": "#/parameters/PatientSourceId" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "FHIR Patient carrying the editable home address.",
            "schema": { "$ref": "#/definitions/PatientUpdate" }
          }
        ],
        "responses": {
          "200": {
            "description": "FHIR Patient updated",
            "headers": {
              "X-FHIR-HTTP-Method": { "type": "string", "enum": ["PUT"] },
              "Content-Location": { "type": "string" }
            },
            "schema": { "$ref": "#/definitions/Patient" }
          },
          "201": {
            "description": "FHIR Patient created",
            "headers": {
              "X-FHIR-HTTP-Method": { "type": "string", "enum": ["PUT"] },
              "Content-Location": { "type": "string" }
            },
            "schema": { "$ref": "#/definitions/Patient" }
          },
          "400": { "$ref": "#/responses/InvalidPatient" },
          "404": { "$ref": "#/responses/NotFound" },
          "409": { "$ref": "#/responses/ImmutableIdentifier" },
          "500": { "$ref": "#/responses/InternalError" },
          "502": { "$ref": "#/responses/FHIRGatewayError" }
        }
      },
      "delete": {
        "operationId": "DeletePatient",
        "summary": "Delete the Patient from the FHIR repository",
        "description": "Finds the target Patient by the source patient's IPP and deletes it. The data.patient source record is preserved.",
        "produces": ["application/fhir+json"],
        "parameters": [
          { "$ref": "#/parameters/PatientSourceId" }
        ],
        "responses": {
          "204": {
            "description": "FHIR Patient deleted",
            "headers": {
              "X-FHIR-HTTP-Method": { "type": "string", "enum": ["DELETE"] },
              "Content-Location": { "type": "string" }
            }
          },
          "404": { "$ref": "#/responses/NotFound" },
          "502": { "$ref": "#/responses/FHIRGatewayError" }
        }
      }
    }
  },
  "parameters": {
    "PatientSourceId": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "Internal data.patient source identifier"
    }
  },
  "responses": {
    "InvalidPatient": {
      "description": "Invalid JSON, resource type, or address",
      "schema": { "$ref": "#/definitions/OperationOutcome" }
    },
    "NotFound": {
      "description": "Source patient not found",
      "schema": { "$ref": "#/definitions/OperationOutcome" }
    },
    "ImmutableIdentifier": {
      "description": "The Patient logical id or IPP was modified",
      "schema": { "$ref": "#/definitions/OperationOutcome" }
    },
    "InternalError": {
      "description": "Patient mapping or persistence failed",
      "schema": { "$ref": "#/definitions/OperationOutcome" }
    },
    "FHIRGatewayError": {
      "description": "FHIR synchronization failed",
      "schema": { "$ref": "#/definitions/OperationOutcome" }
    }
  },
  "definitions": {
    "VersionDetails": {
      "type": "object",
      "required": ["system", "instance", "hostname", "namespace", "version", "timestamp", "username"],
      "properties": {
        "system": { "type": "string" },
        "instance": { "type": "string" },
        "hostname": { "type": "string" },
        "namespace": { "type": "string" },
        "version": { "type": "string" },
        "timestamp": { "type": "string" },
        "uptime": { "type": "string" },
        "username": { "type": "string" }
      }
    },
    "Patient": {
      "type": "object",
      "required": ["resourceType", "id", "identifier", "active", "name", "telecom", "gender"],
      "properties": {
        "resourceType": { "type": "string", "enum": ["Patient"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9\\-.]{1,64}$" },
        "identifier": {
          "type": "array",
          "items": { "$ref": "#/definitions/Identifier" }
        },
        "active": { "type": "boolean" },
        "name": {
          "type": "array",
          "items": { "$ref": "#/definitions/HumanName" }
        },
        "telecom": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContactPoint" }
        },
        "gender": { "type": "string", "enum": ["male", "female", "other", "unknown"] },
        "birthDate": { "type": "string", "format": "date" },
        "deceasedBoolean": { "type": "boolean" },
        "deceasedDateTime": { "type": "string" },
        "address": {
          "type": "array",
          "items": { "$ref": "#/definitions/Address" }
        },
        "extension": {
          "type": "array",
          "items": { "$ref": "#/definitions/PatientExtension" }
        }
      }
    },
    "PatientUpdate": {
      "type": "object",
      "required": ["resourceType", "address"],
      "properties": {
        "resourceType": { "type": "string", "enum": ["Patient"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9\\-.]{1,64}$" },
        "identifier": {
          "type": "array",
          "items": { "$ref": "#/definitions/Identifier" }
        },
        "address": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Address" }
        }
      }
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "HumanName": {
      "type": "object",
      "properties": {
        "use": { "type": "string", "enum": ["official", "maiden"] },
        "family": { "type": "string" },
        "given": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ContactPoint": {
      "type": "object",
      "properties": {
        "system": { "type": "string", "enum": ["phone", "email"] },
        "value": { "type": "string" },
        "use": { "type": "string", "enum": ["home", "mobile", "temp"] }
      }
    },
    "Address": {
      "type": "object",
      "properties": {
        "use": { "type": "string", "enum": ["home", "work", "temp", "old", "billing"] },
        "line": { "type": "array", "items": { "type": "string" } },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "PatientExtension": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "valueAddress": { "$ref": "#/definitions/Address" }
      }
    },
    "OperationOutcome": {
      "type": "object",
      "required": ["resourceType", "issue"],
      "properties": {
        "resourceType": { "type": "string", "enum": ["OperationOutcome"] },
        "issue": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/OperationOutcomeIssue" }
        }
      }
    },
    "OperationOutcomeIssue": {
      "type": "object",
      "required": ["severity", "code"],
      "properties": {
        "severity": { "type": "string", "enum": ["error"] },
        "code": { "type": "string", "enum": ["not-found", "invalid", "exception"] },
        "diagnostics": { "type": "string" }
      }
    }
  }
}