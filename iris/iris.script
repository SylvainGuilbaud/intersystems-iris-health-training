    
    zn "USER"
    
    // Import and compile adm.utils class
    do $system.OBJ.Import("/home/irisowner/dev/src/adm/utils.cls")
    
    #; do $SYSTEM.OBJ.Load("/home/irisowner/dev/zpm-0.10.7.xml","ck")
    set r=##class(%Net.HttpRequest).%New(),r.Server="pm.community.intersystems.com",r.SSLConfiguration="ISC.FeatureTracker.SSL.Config" d r.Get("/packages/zpm/latest/installer"),$system.OBJ.LoadStream(r.HttpResponse.Data,"c")

    zpm "enable -map -globally"
    zpm "enable -community"
    zpm "install swagger-ui" 
 
    zn "%SYS"

    set app = "/csp/training"
    set appProperties("DeepSeeEnabled")=1
    set sc = ##class(Security.Applications).Modify(app,.appProperties)

    set SQLGateway = ##class(%SQLConnection).%New()
    set SQLGateway.Name = "iris"
    set SQLGateway.isJDBC = 1
    set SQLGateway.driver = "com.intersystems.jdbc.IRISDriver"
    set SQLGateway.URL = "jdbc:IRIS://host.docker.internal:11972/IRISAPP"
    set SQLGateway.classpath = "/jdbc/intersystems-jdbc-3.10.5.jar"
    set SQLGateway.Usr = "_SYSTEM"
    set SQLGateway.pwd = "SYS"
    set sc = SQLGateway.%Save()

    set SQLGateway = ##class(%SQLConnection).%New()
    set SQLGateway.Name = "mysql"
    set SQLGateway.isJDBC = 1
    set SQLGateway.driver = "com.mysql.cj.jdbc.Driver"
    set SQLGateway.URL = "jdbc:mysql://host.docker.internal:3306/formation"
    set SQLGateway.classpath = "/jdbc/mysql-connector-java-8.0.26.jar"
    set SQLGateway.Usr = "formation"
    set SQLGateway.pwd = "formation"
    set sc = SQLGateway.%Save()

    set SQLGateway = ##class(%SQLConnection).%New()
    set SQLGateway.Name = "oracle"
    set SQLGateway.isJDBC = 1
    set SQLGateway.driver = "oracle.jdbc.driver.OracleDriver"
    set SQLGateway.URL = "jdbc:oracle:thin:@host.docker.internal:1521:orcl"
    set SQLGateway.classpath = "/jdbc/ojdbc11.jar"
    set SQLGateway.Usr = "oracle"
    set SQLGateway.pwd = "oracle"
    set sc = SQLGateway.%Save()

    set SQLGateway = ##class(%SQLConnection).%New()
    set SQLGateway.Name = "mssql"
    set SQLGateway.isJDBC = 1
    set SQLGateway.driver = "com.microsoft.sqlserver.jdbc.SQLServerDriver"
    set SQLGateway.URL = "jdbc:sqlserver://mssql:1433;databaseName=master;encrypt=false"
    set SQLGateway.classpath = "/jdbc/mssql-jdbc-13.2.1.jre11.jar"
    set SQLGateway.Usr = "sa"
    set SQLGateway.pwd = "sa"
    set sc = SQLGateway.%Save()

    set SQLGateway = ##class(%SQLConnection).%New()
    set SQLGateway.Name = "postgres"
    set SQLGateway.isJDBC = 1
    set SQLGateway.driver = "org.postgresql.Driver"
    set SQLGateway.URL = "jdbc:postgresql://host.docker.internal:52004/postgres"
    set SQLGateway.classpath = "/jdbc/postgresql-42.6.0.jar"
    set SQLGateway.Usr = "postgres"
    set SQLGateway.pwd = "postgres"
    set sc = SQLGateway.%Save()

    set sourceRoot = "/home/irisowner/dev/src"

    zn "DGLAB"

    // Import DGLAB sources without compiling the TRAINING-only FHIR module.
    kill sourceEntries
    set sourceEntry = $ZSearch(sourceRoot _ "/*"), sourceCount = 0
    while sourceEntry '= "" {
        set sourceName = $Piece(sourceEntry, "/", $Length(sourceEntry, "/"))
        if (sourceName '= "training") && (sourceName '= "TRAININGPKG") && (sourceName '= ".DS_Store") {
            set sourceCount = sourceCount + 1
            set sourceEntries(sourceCount) = sourceEntry
        }
        set sourceEntry = $ZSearch("")
    }
    for sourceIndex = 1:1:sourceCount {
        set sc = $SYSTEM.OBJ.Import(sourceEntries(sourceIndex), "ck")
    }
    do ##class(EnsLib.HL7.SchemaXML).Import("/home/irisowner/dev/src/HL7v2/HL7v25IHE.HL7")

    #; Shared transcoding lookup tables reused by both ADT and ORU
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/DGLAB/lookup/Titles.xml","ck")
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/DGLAB/lookup/PatientClasses.xml","ck")
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/DGLAB/lookup/Gender.xml","ck")

    // IHE LAW simulator (LAB-27/28/29): add its items to the production of the DGLAB namespace
    do $SYSTEM.OBJ.Import(sourceRoot _ "/DGLAB/law", "ck")
    do ##class(DGLAB.law.Setup).AddToProduction("DGLABPKG.FoundationProduction")

    zn "TRAINING"

    // The IHE LAW simulator classes are also needed by TRAININGPKG.FoundationProduction
    do $SYSTEM.OBJ.Import(sourceRoot _ "/DGLAB/law", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/data/address.cls", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/data/users.cls", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/data/patient.cls", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/pyprod/generated", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/training/fhir", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/weather", "ck")
    set sc = $SYSTEM.OBJ.Import(sourceRoot _ "/TRAININGPKG/FoundationProduction.cls", "ck")
    set sc = ##class(training.fhir.PatientREST).Install("/specfirst/foch", "TRAINING")

    set patientId = ##class(training.fhir.PatientMapper).FindPatientIdByIPP("G7809", .sc)
    if patientId = "" {
        set patient = ##class(data.patient).%New()
        set patient.IPP = "G7809"
        set patient.firstName = "Anne"
        set patient.lastName = "VERSAIRE"
        set patient.DOB = $ZDateH("1985-01-24", 3)
        set patient.sex = 2
        set patient.status = "qualified"
        set patient.homeAddress.PostalCode = "75001"
        set patient.homeAddress.City = "Paris"
        set patient.homeAddress.Country = "France"
        set patient.birthPlace.PostalCode = "69001"
        set patient.birthPlace.City = "Lyon"
        set patient.birthPlace.Country = "France"
        set sc = patient.%Save()
    }

    // Keycloak (OIDC / OAuth 2.0) integration: roles, server definition, resource server, web apps.
    // Idempotent (also replayable on an existing container with configure-oidc.sh) and independent of
    // Keycloak being up: its endpoints are declared explicitly. See src/adm/oidc.cls.
    zn "COMMON"
    do $SYSTEM.OBJ.Import("/home/irisowner/dev/src/adm/oidc.cls", "ck")
    do ##class(adm.oidc).Configure()

    // Native LDAP authentication: the structure only (LDAP configuration, default domain, LDAP method on the service and the
    // portal applications). The password of the search account is a secret and must not be baked in the image: after the
    // build, run ./configure-ldap.sh (see docs/LDAP-IRIS-Security.md) to send it. The LDAP server itself is the "ldap" service
    // of docker-compose.yml. The LDAP groups map to the iris-* roles created just above by adm.oidc.
    do $SYSTEM.OBJ.Import("/home/irisowner/dev/src/adm/ldap.cls", "ck")
    do ##class(adm.ldap).Configure("")

    halt