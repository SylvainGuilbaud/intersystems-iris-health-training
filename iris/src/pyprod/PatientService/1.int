OnInit() methodimpl {
    s status = 1
    try{
        set pyprod = ##class(%SYS.Python).Import("intersystems_pyprod")
        do $method(pyprod,"_add_to_sys_path","/code/pyprod")
        set PyLib = ##class(%SYS.Python).Import("production")
        set ..PythonClassObject = PyLib.PatientService($this)
    } catch e {
        set status = $system.Status.Error(5001, e.AsSystemError())
        Do ##class(Ens.Util.Log).LogError($classname(),"OnInit","Error while importing the class PatientService: "_status)
    }
    Quit status }
