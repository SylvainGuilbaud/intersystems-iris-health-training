CurrentWeather(pRequest,pResponse) methodimpl {
    try{
          Set arr = ..PythonClassObject.AnyMethodHelper(pRequest,"CurrentWeather")
          set status = arr."__getitem__"("status")
          if arr."__getitem__"("response_available"){
            set pResponse = arr."__getitem__"("response") 
            }
      } catch e {
          set status = $system.Status.Error(5001, e.AsSystemError())
          Do ##class(Ens.Util.Log).LogError($classname(),"CurrentWeather",status)
      }
    Quit status }
