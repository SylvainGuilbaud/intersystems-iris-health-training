%PurgeIndices(idxlist="",lockExtent=0,pIgnoreIndexList="",pJournalFlag="",pDeleteMappings=0) methodimpl {
	Set locked=0,sc=1,originalJournalingMode=('($view(0,-1,4)\1024#2)),journalingChanged=0
	Try {
		if ($listlength(idxlist)=1)&&($listget(idxlist,1)="") { return 1 }
		Set tPtr=0
		While $listnext(idxlist,tPtr,tIndex) {
			continue:tIndex=""
			If $s($d(^oddCOM($classname(),"i",tIndex,2))#2:^(2),$d(^oddCOM($g(^(2),$classname()),"i",tIndex,2))#2:^(2),1:$s($d(^oddDEF($g(^oddCOM($classname(),"i",tIndex,2),$classname()),"i",tIndex,2))#2:^(2),1:""))'=$classname() {
				Set sc=$select(+sc:$$Error^%apiOBJ(5066,$classname()_"::"_tIndex),1:$$AppendStatus^%occSystem(sc,$$Error^%apiOBJ(5066,$classname()_"::"_tIndex)))
			}
		}
		If ('sc) { Return sc }
		If lockExtent {
			Set sc=..%LockExtent(0)
			If ('sc) { Return sc }
			Set locked=1
		}
		If pJournalFlag'="" {
			Try {
				If pJournalFlag=0,originalJournalingMode Do DISABLE^%SYS.NOJRN() set journalingChanged = 1
				If pJournalFlag=1,'originalJournalingMode Do ENABLE^%SYS.NOJRN() set journalingChanged = 1
			} Catch tException {
				Set sc=$$Error^%apiOBJ(1151)
			}
			QUIT:('sc)
		}
		If $system.CLS.IsMthd("%OnBeforePurgeIndices") {
			Set sc=..%OnBeforePurgeIndices(.idxlist)
			QUIT:(('sc))||(($listlength(idxlist)=1)&&($listget(idxlist,1)=""))
		}
		if ((idxlist="")||($listfind(idxlist,"$pyprod.PatientProcess"))),'$listfind(pIgnoreIndexList,"$pyprod.PatientProcess") {
			kill ^Ens.BusinessProcessI("$pyprod.PatientProcess")
			kill ^rINDEXEXT("E",$zconvert($classname(),"u"),"idxBuilt","$pyprod.PatientProcess")
		}
		Set sc=1
		If $system.CLS.IsMthd("%OnAfterPurgeIndices") { Set sc=..%OnAfterPurgeIndices(.idxlist) }
	} Catch tException {
		Set sc=tException.AsStatus(),$ZE=""
	}
	If locked { Do ..%UnlockExtent(0) }
	If journalingChanged {
		If originalJournalingMode {
			Do ENABLE^%SYS.NOJRN()
		} Else {
			Do DISABLE^%SYS.NOJRN()
		}
	}
	Quit sc }
%SQLAcquireLock(%rowid,s=0,unlockref=0) methodimpl
